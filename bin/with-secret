#!/bin/sh
# with-secret [--optional] NAME [[--optional] NAME...] -- command [args...]
#
# Reads each NAME from the OS secret store and exports it as an environment
# variable of the same name, then execs the command. MCP configs that call this
# script contain only NAMEs, never values. Nothing is written to stdout (MCP
# stdio servers use it); errors go to stderr. A missing secret is fatal unless
# its NAME is preceded by --optional, in which case it is simply left unset
# (e.g. mineru-open-mcp then runs in tokenless Flash mode).
#
# Backends (first that applies):
#   macOS : Keychain generic password, service "claude-mcp:NAME", account $USER
#   Linux : libsecret `secret-tool` attribute service=claude-mcp:NAME
#           else file ${XDG_CONFIG_HOME:-~/.config}/with-secret/NAME (must be mode 0600 or 0400)
#
# Add / update a secret (value read from stdin, never from the command line):
#   macOS : printf 'add-generic-password -U -s "claude-mcp:NAME" -a "%s" -w "VALUE"\n' "$USER" | security -i
#   Linux : secret-tool store --label="claude-mcp:NAME" service "claude-mcp:NAME"
#           (or: install -m 600 /dev/stdin ~/.config/with-secret/NAME, then paste + Ctrl-D)

set -f  # names are data: never glob-expand them
user="${USER:-$(id -un)}"
names=""        # validated names, space-separated (validation forbids spaces)
optional=" "    # names that may be missing
next_optional=0
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --optional) next_optional=1; shift; continue ;;
    ''|[0-9]*|*[!A-Za-z0-9_]*) echo "with-secret: invalid name '$1'" >&2; exit 64 ;;
  esac
  names="$names $1"
  [ $next_optional -eq 1 ] && optional="$optional$1 "
  next_optional=0
  shift
done

[ $# -gt 0 ] || { echo "with-secret: no command given after --" >&2; exit 64; }

read_secret() {
  if [ -x /usr/bin/security ]; then
    /usr/bin/security find-generic-password -s "claude-mcp:$1" -a "$user" -w 2>/dev/null
    return
  fi
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service "claude-mcp:$1" 2>/dev/null && return
  fi
  f="${XDG_CONFIG_HOME:-$HOME/.config}/with-secret/$1"
  [ -f "$f" ] || return 1
  case "$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null)" in
    600|400) ;;
    *) echo "with-secret: $f must be mode 0600" >&2; return 1 ;;
  esac
  cat "$f"
}

for name in $names; do
  if value=$(read_secret "$name") && [ -n "$value" ]; then
    export "$name=$value"
  else
    case "$optional" in
      *" $name "*) ;;  # optional and absent: leave unset
      *) echo "with-secret: secret 'claude-mcp:$name' not found or not readable" >&2; exit 1 ;;
    esac
  fi
done

exec "$@"
